# .env.rpi.example — copy to .env.rpi on the hardware node and fill in.
#
# 20260831 ++ RG #split_env_per_host
# Deliberately the short file. This node needs to reach the backend, drive a printer and
# a camera, and put a clip somewhere. It must never hold a payment key, the admin
# password or the Cloudflare tunnel token: if it is ever compromised, the blast radius
# has to stop at the printer. See .env.homeserver.example for the rest.
#
# Everything here is a placeholder. The real values live only in the untracked .env.rpi.

# Where the backend answers on the LAN. Plain HTTP on purpose: this link never leaves
# the local network and never crosses the tunnel.
BACKEND_URL=http://backend-host.invalid:3000

# The shared secret, identical to the one in .env.homeserver. The backend also fences
# this channel by source address (HARDWARE_ALLOWED_IPS over there), so a leaked token
# alone does not buy access to the print queue.
HARDWARE_TOKEN=

# fake | escpos
PRINTER_KIND=escpos
# Dove il finto stampante scrive cio che avrebbe stampato. Letto solo con PRINTER_KIND=fake.
PRINTER_SPOOL_PATH=/tmp/inkless-spool.txt
# Read them from `lsusb` once the printer is bought. Hex accepted, e.g. 0x04b8.
PRINTER_USB_VENDOR_ID=
PRINTER_USB_PRODUCT_ID=

# fake | ffmpeg
RECORDER_KIND=ffmpeg
WEBCAM_DEVICE=/dev/video0

# Only read by docker-compose.rpi.yml. The container needs these host GIDs to
# open devices whose permissions were granted by group, not by owner.
# Find them on the node with: getent group plugdev | cut -d: -f3
#                             getent group video   | cut -d: -f3
PRINTER_GROUP_GID=
WEBCAM_GROUP_GID=

# local | s3
UPLOADER_KIND=s3
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
PUBLIC_CLIPS_URL=

# --- Live stream (optional) -------------------------------------------------
# Full ingest URL, stream key included. Only read when the streamer service is started
# explicitly with `--profile stream`; leaving it empty is fine otherwise.
STREAM_INGEST_URL=
