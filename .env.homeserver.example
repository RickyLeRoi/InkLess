# .env.homeserver.example — copy to .env.homeserver and fill in with the real values.
#
# 20260831 ++ RG #split_env_per_host
# Two example files, not one, because there are two machines and they are not equally
# defensible. The Raspberry Pi is the node with a printer bolted to it and a camera on
# top: it is the one that gets moved, lent and unplugged. Nothing in this file — Stripe
# keys, the admin password, the tunnel token — has any business being on it. See
# .env.rpi.example for the other half.
#
# Everything here is a placeholder. No address, host name or key describes a real
# deployment: the actual topology lives only in the untracked .env.homeserver.

# --- Backend (home server) --------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=/app/data/inkless.db

# Address the backend port is published on. Keep it to the LAN interface the hardware
# node reaches; 127.0.0.1 publishes nothing beyond the host itself.
BACKEND_BIND_IP=127.0.0.1

# Where the browser lands after paying. Must match the public site.
PUBLIC_BASE_URL=https://example.invalid
# Comma-separated origins allowed to call the API, or * in development. With nginx in
# front the browser never crosses an origin, so this only matters if something reaches
# the backend by another route. Keep it narrow anyway.
CORS_ORIGIN=https://example.invalid

# Moderation dashboard.
ADMIN_USER=
ADMIN_PASSWORD=

# Shared secret between the backend and the hardware daemon. LAN only, never tunnelled.
# The same value goes into .env.rpi on the node.
HARDWARE_TOKEN=

# Addresses allowed to talk to /internal at all, comma separated, checked on the socket
# in addition to the token above. The house network is flat, so without this a leaked
# token means every device on it can read the print queue. Leave empty to skip the check
# (development only) — in production put the hardware node's LAN address here.
HARDWARE_ALLOWED_IPS=

# Hops allowed to say who the caller is, comma separated. Accepts proxy-addr names
# (loopback, linklocal, uniquelocal) or CIDRs. Must cover the nginx container and no
# more: anything listed here can dictate the address the rate limits are keyed on.
TRUSTED_PROXIES=loopback,uniquelocal

RATE_LIMIT_SUBMISSIONS_PER_HOUR=3
RATE_LIMIT_PRINTS_PER_HOUR=10

# --- Moderazione ------------------------------------------------------------
# Quanti messaggi pending non ancora visti dal modello servono per far partire un
# batch. Sotto questa soglia decide solo il filtro regex.
MODERATION_LLM_THRESHOLD=50
MODERATION_LLM_BATCH_SIZE=100
# ollama | openai | none. Con "none" il batch non parte mai e la coda resta manuale.
#
# "ollama"  -> API nativa, base URL senza suffisso:  http://<llm-host>:11434
# "openai"  -> protocollo chat/completions, include il /v1 nella base URL. Vale per
#              OpenAI, LM Studio, vLLM, llama.cpp server, OpenRouter e lo shim di
#              Ollama stesso (http://<llm-host>:11434/v1).
MODERATION_LLM_PROVIDER=ollama
MODERATION_LLM_BASE_URL=http://llm-host.invalid:11434
MODERATION_LLM_MODEL=llama3.2:3b
# Vuota per i runtime locali che non chiedono autenticazione.
MODERATION_LLM_API_KEY=

# --- Payments ---------------------------------------------------------------
# stripe | paypal | fake. "fake" is refused when NODE_ENV=production.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Serve solo con PAYMENT_PROVIDER=paypal. Il webhook id e quello che PayPal assegna
# all'endpoint quando lo registri: entra nella firma, quindi uno sbagliato fa fallire
# la verifica di ogni notifica.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# live | sandbox
PAYPAL_ENVIRONMENT=sandbox

# --- Cloudflare -------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

