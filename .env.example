# .env.example — copy to .env and fill in. .env is gitignored.

# --- Backend (home server, 192.168.1.248) -----------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=/app/data/inkless.db

# Where the browser lands after paying. Must match the public site.
PUBLIC_BASE_URL=https://inkless.giordanoriccardo.it
# Comma-separated origins allowed to call the API, or * in development.
CORS_ORIGIN=https://inkless.giordanoriccardo.it

# Moderation dashboard. Cloudflare Access sits in front of this too.
ADMIN_USER=
ADMIN_PASSWORD=

# Shared secret between the backend and the RPi daemon. LAN only, never tunnelled.
HARDWARE_TOKEN=

RATE_LIMIT_SUBMISSIONS_PER_HOUR=3
RATE_LIMIT_PRINTS_PER_HOUR=10

# --- Moderazione ------------------------------------------------------------
# Quanti messaggi pending non ancora visti dal modello servono per far partire un
# batch. Sotto questa soglia decide solo il filtro regex.
MODERATION_LLM_THRESHOLD=50
MODERATION_LLM_BATCH_SIZE=100
# ollama | openai | none. Con "none" il batch non parte mai e la coda resta manuale.
#
# "ollama"  -> API nativa, base URL senza suffisso:  http://192.168.1.254:11434
# "openai"  -> protocollo chat/completions, include il /v1 nella base URL. Vale per
#              OpenAI, LM Studio, vLLM, llama.cpp server, OpenRouter e lo shim di
#              Ollama stesso (http://192.168.1.254:11434/v1).
MODERATION_LLM_PROVIDER=ollama
MODERATION_LLM_BASE_URL=http://192.168.1.254:11434
MODERATION_LLM_MODEL=llama3.2:3b
# Vuota per i runtime locali che non chiedono autenticazione.
MODERATION_LLM_API_KEY=

# --- Payments ---------------------------------------------------------------
# stripe | fake. "fake" is refused when NODE_ENV=production.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare -------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# --- Hardware node (RPi 4, 192.168.1.254) -----------------------------------
BACKEND_URL=http://192.168.1.248:3000

# fake | escpos
PRINTER_KIND=escpos
# Read them from `lsusb` once the printer is bought. Hex accepted, e.g. 0x04b8.
PRINTER_USB_VENDOR_ID=
PRINTER_USB_PRODUCT_ID=

# fake | ffmpeg
RECORDER_KIND=ffmpeg
WEBCAM_DEVICE=/dev/video0

# local | s3
UPLOADER_KIND=s3
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
PUBLIC_CLIPS_URL=

# --- Live stream (optional) -------------------------------------------------
TWITCH_STREAM_KEY=
