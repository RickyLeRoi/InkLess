# Secrets
# 20260831 ** RG #split_env_per_host
# One .env per machine now (.env.homeserver, .env.rpi), so the un-ignore has to match
# the .example suffix wherever it lands, not just the single old filename.
.env
.env.*
!.env.*.example

# Node
node_modules/
dist/
build/
*.log
npm-debug.log*

# Python (RPi hardware node)
__pycache__/
*.py[cod]
.venv/
venv/

# Database
*.db
*.db-journal
*.sqlite
*.sqlite3

# Captured media
*.mp4
recordings/

# OS
.DS_Store

# AI
CLAUDE.md
PLAN.md
prompt.txt